# Scaffold app: proves the dev.sh loop end to end with zero effect on SignalK.
# It's a standalone script, so RUN just executes it and prints the Pi's state.
# Copy this pattern for real apps; for a SignalK plugin, see apps/README.md.
REMOTE_DIR="/home/pi/apps/pi-health"
INSTALL=""                      # no deps to install
RUN="node /home/pi/apps/pi-health/index.js"
LOGS=""
